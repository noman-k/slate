# Public project URL and publishable key only. Never add a service-role key here.
# Copy to .env.local for next dev, and configure the same build variables in CI.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Both Supabase variables are required: Slate has no demo, everyone signs in.
