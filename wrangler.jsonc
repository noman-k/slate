{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slate-workspace",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": ".open-next/assets", "binding": "ASSETS"},
  // The hosted version's address. Self-hosting? Use your own domain here (it must be a
  // zone in the same Cloudflare account), or remove "routes" to use workers.dev.
  // Cloudflare creates the DNS record and certificate on deploy.
  "routes": [{"pattern": "slate.noman.io", "custom_domain": true}],
  // Requests per minute, counted by Cloudflare per location (see src/lib/rate-limit.ts, and
  // keep LIMITS there in step). namespace_id only has to be unique within your account.
  "ratelimits": [
    {"name": "RUN_REQUEST_LIMITER", "namespace_id": "1001", "simple": {"limit": 30, "period": 60}},
    {"name": "MCP_KEY_LIMITER", "namespace_id": "1002", "simple": {"limit": 120, "period": 60}},
    {"name": "MCP_IP_LIMITER", "namespace_id": "1003", "simple": {"limit": 300, "period": 60}},
    {"name": "CONTACT_LIMITER", "namespace_id": "1004", "simple": {"limit": 5, "period": 60}}
  ],
  "observability": {"enabled": true}
}
