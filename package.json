{
  "name": "slate-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "A private workspace for notes, databases and runnable playbooks, readable by AI agents over MCP.",
  "license": "AGPL-3.0-only",
  "homepage": "https://slate.noman.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noman-k/slate.git"
  },
  "bugs": {
    "url": "https://github.com/noman-k/slate/issues"
  },
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "node scripts/check-node.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/hover-media.mjs --check",
    "test": "vitest run",
    "prebuild:worker": "node scripts/check-node.mjs",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy": "npm run build:worker && node scripts/deploy-worker.mjs",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:e2e": "playwright test",
    "test:auth": "node scripts/test-local-auth.mjs",
    "test:db": "supabase test db",
    "deploy:check": "node scripts/deploy-worker.mjs --check"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.80.0",
    "@tiptap/react": "^3.10.0",
    "@tiptap/starter-kit": "^3.10.0",
    "@tiptap/extension-placeholder": "^3.10.0",
    "@tiptap/extension-task-list": "^3.10.0",
    "@tiptap/extension-task-item": "^3.10.0",
    "@tiptap/extension-image": "^3.10.0",
    "@tiptap/extension-table": "^3.10.0",
    "@tiptap/extension-code-block-lowlight": "^3.10.0",
    "@tiptap/markdown": "^3.10.0",
    "@tiptap/pm": "^3.10.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.13.1",
    "@lezer/highlight": "^1.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "@codemirror/view": "^6.38.0",
    "@codemirror/state": "^6.5.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "lucide-react": "^0.468.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0",
    "lowlight": "^3.3.0",
    "sonner": "^2.0.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.11.0",
    "wrangler": "^4.45.0",
    "typescript": "^5.9.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.0",
    "vitest": "^4.1.12",
    "@playwright/test": "^1.56.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "glob@>=9.0.0 <14.0.2": "14.0.5",
    "minimatch@>=7.0.0 <11.0.1": "11.0.8"
  }
}
